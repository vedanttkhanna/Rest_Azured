    "predev:live": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "ajv": "^8.20.0",
    "aws-amplify": "^6.22.1",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.13.0",
    "msw": "^3.0.3",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
