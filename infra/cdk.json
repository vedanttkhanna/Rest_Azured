{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/__pycache__", "tests", ".build"]
  },
  "context": {
    "fetch": "stub",
    "segment": "stub",
    "simulate": "stub",
    "model_tar": "data/models/package/model.tar.gz",
