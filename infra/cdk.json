    "seg_memory_mb": 4096,
    "seg_max_concurrency": 2,
    "web_origins": "http://localhost:5173",
    "quota_homeowner": 20,
    "quota_installer": 100,
    "batch_max": 25,
    "places_region": "ap-south-1"
  }
}
