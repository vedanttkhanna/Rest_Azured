{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract C — P2 solar assessment",
  "type": "object",
  "required": [
    "job_id",
    "status",
    "building",
    "system",
    "panels",
    "energy",
    "finance",
    "co2_t_per_year",
    "heatmap_png_s3_uri",
    "heatmap_bounds",
    "assumptions",
    "data_sources",
    "model_version"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "done"
    },
    "building": {
      "type": "object",
      "required": [
        "roof_area_m2",
        "usable_area_m2"
      ],
      "properties": {
        "roof_area_m2": {
          "type": "number",
          "minimum": 0
        },
        "usable_area_m2": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "system": {
      "type": "object",
      "required": [
        "panel_count",
        "panel_wp",
        "kw_dc",
        "tilt_deg",
        "azimuth_deg"
      ],
      "properties": {
        "panel_count": {
          "type": "integer",
          "minimum": 0
        },
        "panel_wp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kw_dc": {
          "type": "number",
          "minimum": 0
        },
        "tilt_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 90
        },
        "azimuth_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      }
    },
    "panels": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ]
                      }
                    }
                  }
                }
              },
              "properties": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "energy": {
      "type": "object",
      "required": [
        "annual_kwh",
        "monthly_kwh",
        "specific_yield_kwh_per_kwp",
        "shade_loss_pct"
      ],
      "properties": {
        "annual_kwh": {
          "type": "number",
          "minimum": 0
        },
        "monthly_kwh": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "specific_yield_kwh_per_kwp": {
          "type": "number",
          "minimum": 0
        },
        "shade_loss_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "finance": {
      "type": "object",
      "required": [
        "capex_inr",
        "subsidy_inr",
        "net_cost_inr",
        "annual_savings_inr",
        "payback_years"
      ],
      "properties": {
        "capex_inr": {
          "type": "number",
          "minimum": 0
        },
        "subsidy_inr": {
          "type": "number",
          "minimum": 0
        },
        "net_cost_inr": {
          "type": "number",
          "minimum": 0
        },
        "annual_savings_inr": {
          "type": "number",
          "minimum": 0
        },
        "payback_years": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Null when annual savings are zero; no finite payback."
        }
      }
    },
    "co2_t_per_year": {
      "type": "number",
      "minimum": 0
    },
    "heatmap_png_s3_uri": {
      "type": "string",
      "minLength": 1
    },
    "heatmap_bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "assumptions": {
      "type": "object"
    },
    "data_sources": {
      "type": "object",
      "required": [
        "weather",
        "heights"
      ],
      "properties": {
        "weather": {
          "type": "string"
        },
        "heights": {
          "type": "string"
        }
      }
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
